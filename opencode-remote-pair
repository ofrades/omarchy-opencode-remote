#!/usr/bin/env python3
"""One-click tailnet pairing for omarchy-opencode-remote.

Usage:
  opencode-remote-pair send [peer-host] Expose this machine's authenticated
                                          opencode server at its tailnet URL.
                                          With a peer, Taildrop its existing
                                          credential for explicit trust.
  opencode-remote-pair trust <file>       Trust an incoming pairing file from
                                          ~/Downloads: stores the peer and
                                          deletes the file.

`send` binds the tailnet address, restarts the service, maps the tailnet
URL with `tailscale serve`, and Taildrops the effective credential so the
peer lists this machine. It never touches the password: opencode enforces
one on the background service, so it stays stable across exposes.
"""

import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
import time

PAIR_APP_TAG = "omarchy-opencode-remote-pair"


def fail(message):
    print("opencode-remote-pair: %s" % message, file=sys.stderr)
    return 1


def config_home():
    override = os.environ.get("XDG_CONFIG_HOME", "").strip()
    if override:
        return override
    return os.path.join(os.path.expanduser("~"), ".config")


def widget_config_path():
    return os.path.join(config_home(), "omarchy-opencode-remote", "config.json")


def service_config_path():
    return os.path.join(config_home(), "opencode", "service.json")


def validate_pairing_file(path):
    """Reject credentials outside the Taildrop inbox or exposed to other users."""
    downloads = os.path.realpath(os.path.join(os.path.expanduser("~"), "Downloads"))
    candidate = os.path.abspath(path)
    resolved = os.path.realpath(candidate)
    if os.path.dirname(resolved) != downloads:
        return "pairing file must be directly inside ~/Downloads"
    name = os.path.basename(candidate)
    if not name.startswith("opencode-pair-") or not name.endswith(".json"):
        return "unexpected pairing filename"
    try:
        info = os.lstat(candidate)
    except OSError:
        return "pairing file does not exist"
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        return "pairing file must be a regular file, not a link"
    if info.st_uid != os.getuid():
        return "pairing file is not owned by the current user"
    if stat.S_IMODE(info.st_mode) & 0o077:
        return "pairing file permissions expose the credential; run chmod 600 first"
    return ""


def run(command, timeout):
    try:
        completed = subprocess.run(
            command, check=False, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return completed.returncode, (completed.stdout or "").strip()


def load_json_file(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            raw = json.load(handle)
    except (OSError, ValueError):
        return None
    return raw if isinstance(raw, dict) else None


def write_json_file(path, data):
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, exist_ok=True)
    tmp_fd, tmp_path = tempfile.mkstemp(dir=directory or ".", prefix=".tmp-pair-")
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, path)
    finally:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
    os.chmod(path, 0o600)


def tail_ipv4():
    tailscale_bin = shutil.which("tailscale")
    if not tailscale_bin:
        return ""
    exit_code, out = run([tailscale_bin, "ip", "-4"], 8)
    if exit_code != 0 or not out:
        return ""
    return out.split()[0]


def _looks_like_ipv4(value):
    parts = value.split(".")
    if len(parts) != 4:
        return False
    try:
        return all(0 <= int(part) <= 255 for part in parts)
    except ValueError:
        return False


def peer_target(peer):
    """Resolve a tailnet peer to a Taildrop target (MagicDNS name or IP).

    Display HostNames can contain spaces and never resolve as DNS, so look
    the peer up in `tailscale status --json` first. IPs pass through.
    Returns (label, target); target is "" when unresolvable.
    """
    if not peer:
        return "", ""
    if ":" in peer or _looks_like_ipv4(peer):
        return peer, peer
    tailscale_bin = shutil.which("tailscale")
    if not tailscale_bin:
        return peer, ""
    exit_code, out = run([tailscale_bin, "status", "--json"], 8)
    if exit_code != 0 or not out:
        return peer, ""
    try:
        status = json.loads(out)
    except ValueError:
        return peer, ""
    peers = status.get("Peer", {}) or {}
    wanted = peer.lower()
    for entry in peers.values():
        if not isinstance(entry, dict):
            continue
        if str(entry.get("HostName", "") or "").lower() != wanted:
            continue
        host = str(entry.get("HostName", "") or peer)
        dns = str(entry.get("DNSName", "") or "").rstrip(".")
        if dns:
            return host, dns
        ips = entry.get("TailscaleIPs", []) or []
        for ip in ips:
            if "." in str(ip):
                return host, str(ip)
        if ips:
            return host, str(ips[0])
    return peer, ""


def tail_self_name():
    tailscale_bin = shutil.which("tailscale")
    if not tailscale_bin:
        return ""
    exit_code, out = run([tailscale_bin, "status", "--json"], 8)
    if exit_code != 0 or not out:
        return ""
    try:
        status = json.loads(out)
    except ValueError:
        return ""
    yourself = status.get("Self", {}) or {}
    return str(yourself.get("HostName", "") or "")


def widget_config():
    raw = load_json_file(widget_config_path())
    config = {"password": "", "port": 49374, "timeoutSec": 3, "peers": {}}
    if raw:
        if isinstance(raw.get("password"), str):
            config["password"] = raw["password"]
        try:
            port = int(raw.get("port", 49374))
            if 1 <= port <= 65535:
                config["port"] = port
        except (TypeError, ValueError):
            pass
        try:
            timeout = int(raw.get("timeoutSec", 3))
            config["timeoutSec"] = max(1, min(15, timeout))
        except (TypeError, ValueError):
            pass
        peers = raw.get("peers", {}) or {}
        if isinstance(peers, dict):
            for name, entry in peers.items():
                if isinstance(entry, dict) and isinstance(entry.get("password"), str):
                    config["peers"][str(name)] = dict(entry)
    return config


def service_password():
    raw = load_json_file(service_config_path())
    if raw and isinstance(raw.get("password"), str) and raw["password"]:
        return raw["password"]
    return ""


def service_status_url(opencode_bin):
    exit_code, out = run([opencode_bin, "service", "status"], 8)
    if exit_code != 0 or not out:
        return ""
    for token in out.split():
        if token.startswith("http://") or token.startswith("https://"):
            return token.rstrip("/")
    return ""


def serve_dns_name():
    """This machine's MagicDNS name (no trailing dot), or ''."""
    tailscale_bin = shutil.which("tailscale")
    if not tailscale_bin:
        return ""
    exit_code, out = run([tailscale_bin, "status", "--json"], 8)
    if exit_code != 0 or not out:
        return ""
    try:
        status = json.loads(out)
    except ValueError:
        return ""
    yourself = status.get("Self", {}) or {}
    return str(yourself.get("DNSName", "") or "").rstrip(".")


def verify_tailnet_identity(host, tail_ip):
    """Confirm the credential's claimed host/IP is a current Tailscale peer."""
    tailscale_bin = shutil.which("tailscale")
    if not tailscale_bin:
        return False, "tailscale is not installed"
    exit_code, out = run([tailscale_bin, "status", "--json"], 8)
    if exit_code != 0 or not out:
        return False, "could not verify the sender with Tailscale"
    try:
        status = json.loads(out)
    except ValueError:
        return False, "could not verify the sender with Tailscale"
    wanted = str(host).casefold()
    peers = status.get("Peer", {}) or {}
    for peer in peers.values():
        if not isinstance(peer, dict):
            continue
        peer_host = str(peer.get("HostName", "") or "")
        peer_ips = [str(ip) for ip in (peer.get("TailscaleIPs", []) or [])]
        if peer_host.casefold() == wanted and str(tail_ip) in peer_ips:
            if peer.get("Online") is not True:
                return False, "the claimed Tailscale peer is offline"
            return True, ""
    return False, "pairing identity does not match a Tailscale peer"


def cmd_send(peer):
    opencode_bin = shutil.which("opencode")
    if not opencode_bin:
        return fail("opencode is not installed")
    tailscale_bin = shutil.which("tailscale")
    if not tailscale_bin:
        return fail("tailscale is not installed")
    if not peer:
        peer = ""
    config = widget_config()
    pairing_host = tail_self_name() if peer else ""
    pairing_ip = tail_ipv4() if peer else ""
    if peer and (not pairing_host or not pairing_ip):
        return fail("could not determine this machine's Tailscale identity")
    # Never manage the password: opencode enforces one on the background
    # service and regenerates it on start when missing. We leave it alone
    # and share whatever is effective after start, so it stays stable.

    # Bind the tailnet address so desktops can probe directly; the
    # MagicDNS URL (via `tailscale serve` below) is the prettier path.
    # Either way auth is required — opencode guarantees a password.
    bind = tail_ipv4()
    if bind:
        exit_code, _ = run([opencode_bin, "service", "set", "hostname", bind], 15)
        if exit_code != 0:
            return fail("could not bind the service to the tailnet address")
    else:
        exit_code, _ = run([opencode_bin, "service", "set", "hostname", "0.0.0.0"], 15)
        if exit_code != 0:
            return fail("could not bind the service")

    exit_code, _ = run(
        [opencode_bin, "service", "set", "port", str(config["port"])], 15
    )
    if exit_code != 0:
        return fail("could not set the service port")
    # Changing settings stops the service; bring it back with the new config.
    exit_code, _ = run([opencode_bin, "service", "start"], 30)
    if exit_code != 0:
        return fail("could not start the background service")

    url = service_status_url(opencode_bin)
    if not url:
        return fail("service started but its URL is unknown")
    try:
        port = int(url.rsplit(":", 1)[1])
    except (ValueError, IndexError):
        port = config["port"]
    # Effective password post-start (opencode guarantees one exists).
    password = service_password()
    if not password:
        return fail("opencode service has no password; refusing to expose it")
    target = "http://%s:%d" % (bind if bind else "127.0.0.1", port)

    # Pair the server to its tailnet URL: https://<host>.<tailnet>.ts.net/
    serve_note = ""
    exit_code, _ = run(
        [tailscale_bin, "serve", "--bg", "--https=443", target], 30
    )
    if exit_code != 0:
        serve_note = " (tailscale serve failed — direct http://<tailnet-ip>:%d still works)" % port
    else:
        dns = serve_dns_name()
        serve_note = " — https://%s" % dns if dns else " — https enabled"

    if not peer:
        print("Exposed on the tailnet%s — opencode authentication retained." % serve_note)
        if not bind:
            print("Note: bound to all interfaces (Tailscale was unreachable).")
        return 0

    credential = {
        "app": PAIR_APP_TAG,
        "v": 1,
        "host": pairing_host,
        "tailIP": pairing_ip,
        "port": port,
        "username": "opencode",
        "password": password,
        "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }
    staging_fd, staging = tempfile.mkstemp(
        prefix="opencode-pair-%s-" % credential["host"], suffix=".json"
    )
    try:
        with os.fdopen(staging_fd, "w", encoding="utf-8") as handle:
            json.dump(credential, handle, indent=2)
            handle.write("\n")
        os.chmod(staging, 0o600)
        _host, target = peer_target(peer)
        if not target:
            return fail("could not resolve tailnet peer '%s'" % peer)
        exit_code, _ = run([tailscale_bin, "file", "cp", staging, target + ":"], 60)
        if exit_code != 0:
            return fail(
                "could not send to '%s' — is that peer online and accepting files?" % peer
            )
    finally:
        try:
            os.unlink(staging)
        except OSError:
            pass

    print("Exposed on the tailnet%s — pairing sent to %s, ask them to click Trust." % (serve_note, peer))
    if not bind:
        print("Note: bound to all interfaces (Tailscale was unreachable).")
    return 0


def cmd_trust(path):
    unsafe = validate_pairing_file(path)
    if unsafe:
        return fail(unsafe)
    raw = load_json_file(path)
    if raw is None or raw.get("app") != PAIR_APP_TAG:
        return fail("'%s' is not a pairing file" % path)
    if raw.get("v") != 1:
        return fail("unsupported pairing file version")
    host = raw.get("host", "")
    tail_ip = raw.get("tailIP", "")
    password = raw.get("password", "")
    if not isinstance(password, str) or not password:
        return fail("pairing file is incomplete")
    try:
        port = int(raw.get("port", 0))
    except (TypeError, ValueError):
        port = 0
    if not host or not tail_ip or not 1 <= port <= 65535:
        return fail("pairing file is incomplete")
    verified, verify_error = verify_tailnet_identity(host, tail_ip)
    if not verified:
        return fail(verify_error)

    config = widget_config()
    peers = config["peers"]
    peers[str(host)] = {"password": password, "port": port}
    write_json_file(
        widget_config_path(),
        {
            "password": config["password"],
            "port": config["port"],
            "timeoutSec": config["timeoutSec"],
            "peers": peers,
        },
    )
    try:
        os.unlink(path)
    except OSError:
        pass
    print("Trusted %s (%s:%d) — its sessions will appear on refresh." % (host, tail_ip, port))
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print("Usage: opencode-remote-pair send [peer-host] | trust <file>")
        return 0 if len(argv) >= 2 else 1
    action = argv[1]
    if action == "send":
        return cmd_send(argv[2] if len(argv) > 2 else "")
    if action == "trust":
        if len(argv) < 3:
            return fail("usage: opencode-remote-pair trust <file>")
        return cmd_trust(argv[2])
    # The widget never passes secrets on a command line, so there is no
    # code path here that accepts a password argument on purpose.
    return fail("unknown action '%s'" % action)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
