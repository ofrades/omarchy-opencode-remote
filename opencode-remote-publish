#!/usr/bin/env python3
"""Publish this machine's authenticated OpenCode service through Tailscale Serve."""

import json
import os
import shutil
import subprocess
import sys

DEFAULT_PORT = 49374


def fail(message):
    print("opencode-remote-publish: %s" % message, file=sys.stderr)
    return 1


def run(command, timeout):
    try:
        completed = subprocess.run(
            command, check=False, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return completed.returncode, (completed.stdout or "").strip()


def config_home():
    return os.environ.get("XDG_CONFIG_HOME", "").strip() or os.path.join(
        os.path.expanduser("~"), ".config"
    )


def configured_port():
    path = os.path.join(config_home(), "omarchy-opencode-remote", "config.json")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            raw = json.load(handle)
        port = int(raw.get("port", DEFAULT_PORT)) if isinstance(raw, dict) else DEFAULT_PORT
    except (OSError, ValueError, TypeError):
        port = DEFAULT_PORT
    return port if 1 <= port <= 65535 else DEFAULT_PORT


def service_has_password():
    path = os.path.join(config_home(), "opencode", "service.json")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            raw = json.load(handle)
    except (OSError, ValueError):
        return False
    return isinstance(raw, dict) and isinstance(raw.get("password"), str) and bool(raw["password"])


def tailscale_identity(tailscale_bin):
    code, out = run([tailscale_bin, "status", "--json"], 8)
    if code != 0 or not out:
        return "", ""
    try:
        own = (json.loads(out).get("Self", {}) or {})
    except ValueError:
        return "", ""
    ips = [str(value) for value in (own.get("TailscaleIPs", []) or [])]
    ipv4 = next((value for value in ips if "." in value), ips[0] if ips else "")
    dns = str(own.get("DNSName", "") or "").rstrip(".")
    return ipv4, dns


def main():
    opencode_bin = shutil.which("opencode")
    tailscale_bin = shutil.which("tailscale")
    if not opencode_bin:
        return fail("opencode is not installed")
    if not tailscale_bin:
        return fail("tailscale is not installed")

    tail_ip, dns = tailscale_identity(tailscale_bin)
    if not tail_ip or not dns:
        code, _ = run([tailscale_bin, "up"], 30)
        if code == 0:
            tail_ip, dns = tailscale_identity(tailscale_bin)
    if not tail_ip or not dns:
        return fail("could not connect Tailscale; open its panel to sign in")

    port = configured_port()
    for setting, value in (("hostname", tail_ip), ("port", str(port))):
        code, _ = run([opencode_bin, "service", "set", setting, value], 15)
        if code != 0:
            return fail("could not configure the OpenCode service %s" % setting)

    code, _ = run([opencode_bin, "service", "start"], 30)
    if code != 0:
        return fail("could not start the OpenCode background service")
    if not service_has_password():
        return fail("OpenCode service has no password; refusing to publish it")

    target = "http://%s:%d" % (tail_ip, port)
    code, _ = run([tailscale_bin, "serve", "--bg", "--https=443", target], 30)
    if code != 0:
        return fail("could not publish OpenCode with Tailscale Serve")

    print("Published at https://%s/" % dns)
    return 0


if __name__ == "__main__":
    sys.exit(main())
