#!/usr/bin/env python3
"""Open an opencode TUI attached to a remote server over Tailscale.

Usage: opencode-remote-connect <peer-host-or-ip> [session-id|-]

Resolves the peer through `tailscale status --json`, reads the shared
server password from ~/.config/omarchy-opencode-remote/config.json, and
execs `opencode --server http://<ip>:<port> [--session <id>]`.

The password travels in the process environment, never on a command line,
so it does not leak into the widget's process list. Pass "-" (or omit the
session id) to open a fresh TUI on the remote server.
"""

import json
import os
import shutil
import subprocess
import sys


def fail(message):
    print("opencode-remote-connect: %s" % message, file=sys.stderr)
    return 1


def load_config():
    base = os.environ.get("XDG_CONFIG_HOME", "").strip() or os.path.join(
        os.path.expanduser("~"), ".config"
    )
    path = os.path.join(base, "omarchy-opencode-remote", "config.json")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            raw = json.load(handle)
    except (OSError, ValueError):
        return "", 49374, {}, path
    if not isinstance(raw, dict):
        return "", 49374, {}, path
    password = raw.get("password", "")
    if not isinstance(password, str):
        password = ""
    try:
        port = int(raw.get("port", 49374))
    except (TypeError, ValueError):
        port = 49374
    if not 1 <= port <= 65535:
        port = 49374
    peers = raw.get("peers", {}) or {}
    if not isinstance(peers, dict):
        peers = {}
    return password, port, peers, path


def credentials_for(config_password, config_port, peers, host, ip):
    """Pairing entry (by hostname, then by IP) wins over the shared secret.

    Pairing entries normally contain an opencode-managed service password.
    """
    for key in (host, ip):
        if not key:
            continue
        entry = peers.get(key)
        if isinstance(entry, dict) and isinstance(entry.get("password"), str):
            try:
                port = int(entry.get("port", config_port))
            except (TypeError, ValueError):
                port = config_port
            if not 1 <= port <= 65535:
                port = config_port
            return entry["password"], port
    return config_password, config_port


def looks_like_ip(value):
    parts = value.split(".")
    if len(parts) == 4:
        try:
            return all(0 <= int(part) <= 255 for part in parts)
        except ValueError:
            return False
    return ":" in value


def resolve_peer(peer):
    """Return (host_label, ip). Hostnames resolve via tailscale; IPs pass through."""
    if looks_like_ip(peer):
        return peer, peer
    tailscale_bin = shutil.which("tailscale")
    if not tailscale_bin:
        return peer, ""
    try:
        completed = subprocess.run(
            [tailscale_bin, "status", "--json"],
            check=False, capture_output=True, text=True, timeout=8,
        )
    except (OSError, subprocess.TimeoutExpired):
        return peer, ""
    if completed.returncode != 0 or not completed.stdout:
        return peer, ""
    try:
        status = json.loads(completed.stdout)
    except ValueError:
        return peer, ""
    peers = status.get("Peer", {}) or {}
    wanted = peer.lower()
    for entry in peers.values():
        if not isinstance(entry, dict):
            continue
        if str(entry.get("HostName", "") or "").lower() != wanted:
            continue
        host = str(entry.get("HostName", "") or peer)
        ips = entry.get("TailscaleIPs", []) or []
        for ip in ips:
            if "." in str(ip):
                return host, str(ip)
        if ips:
            return host, str(ips[0])
    return peer, ""


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print("Usage: opencode-remote-connect <peer-host-or-ip> [session-id|-]")
        return 0 if len(argv) >= 2 else 1
    peer = argv[1]
    session_id = argv[2] if len(argv) > 2 else "-"

    config_password, config_port, peers, config_path = load_config()
    host, ip = resolve_peer(peer)
    if not ip:
        return fail("could not resolve tailnet peer '%s'" % peer)
    password, port = credentials_for(config_password, config_port, peers, host, ip)
    opencode_bin = shutil.which("opencode")
    if not opencode_bin:
        return fail("opencode is not installed")

    url = "http://%s:%d" % (ip, port)
    command = [opencode_bin, "--server", url]
    if session_id and session_id != "-":
        command += ["--session", session_id]
    env = dict(os.environ)
    if password:
        env["OPENCODE_SERVER_PASSWORD"] = password
    else:
        env.pop("OPENCODE_SERVER_PASSWORD", None)
    os.execvpe(opencode_bin, command, env)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
