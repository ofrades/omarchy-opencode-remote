#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== syntax =="
python3 -m py_compile opencode_remote_status.py opencode-remote-publish
echo OK

echo "== helper output =="
python3 opencode_remote_status.py | python3 -c '
import json, sys
d = json.load(sys.stdin)
assert d.get("ok") is True
assert set(("opencode", "local", "tailscale", "publication")) <= set(d)
assert isinstance(d["local"]["sessions"], list)
assert isinstance(d["local"]["history"], list)
assert isinstance(d["publication"]["published"], bool)
assert isinstance(d["tailscale"]["peers"], list)
print("active:", len(d["local"]["sessions"]), "| published:", d["publication"]["published"], "| peers:", len(d["tailscale"]["peers"]))
'

echo "== browser route =="
python3 -c '
import importlib.util
spec = importlib.util.spec_from_file_location("status", "opencode_remote_status.py")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
url = module.web_session_url("https://laptop.example.ts.net/", "ses_abc")
assert url == "https://laptop.example.ts.net/server/aHR0cHM6Ly9sYXB0b3AuZXhhbXBsZS50cy5uZXQ/session/ses_abc", url
assert module.web_session_url("", "ses_abc") == ""
print(url)
'

echo "== legacy credential cleanup =="
MIGRATION_HOME="$(mktemp -d)"
mkdir -p "$MIGRATION_HOME/omarchy-opencode-remote"
mkdir -p "$MIGRATION_HOME/home/Downloads"
cat > "$MIGRATION_HOME/omarchy-opencode-remote/config.json" <<'JSON'
{"port": 4444, "password": "old-secret", "timeoutSec": 3, "peers": {"desktop": {"password": "peer-secret"}}}
JSON
cat > "$MIGRATION_HOME/home/Downloads/opencode-pair-old.json" <<'JSON'
{"app": "omarchy-opencode-remote-pair", "password": "old-secret"}
JSON
cat > "$MIGRATION_HOME/home/Downloads/opencode-pair-unrelated.json" <<'JSON'
{"app": "something-else", "password": "keep-me"}
JSON
HOME="$MIGRATION_HOME/home" XDG_CONFIG_HOME="$MIGRATION_HOME" python3 -c '
import importlib.util, json, os
spec = importlib.util.spec_from_file_location("status", "opencode_remote_status.py")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
module.migrate_legacy_config()
module.remove_legacy_pairing_files()
path = os.path.join(os.environ["XDG_CONFIG_HOME"], "omarchy-opencode-remote", "config.json")
assert json.load(open(path)) == {"port": 4444}
assert oct(os.stat(path).st_mode & 0o777) == "0o600"
downloads = os.path.join(os.environ["HOME"], "Downloads")
assert not os.path.exists(os.path.join(downloads, "opencode-pair-old.json"))
assert os.path.exists(os.path.join(downloads, "opencode-pair-unrelated.json"))
'
rm -rf "$MIGRATION_HOME"
echo OK

if command -v node >/dev/null 2>&1; then
  echo "== model =="
  node - <<'JS'
const M = require('./Model.js')
const parsed = M.parseStatus(JSON.stringify({
  opencode: { installed: true, version: '2.0.0' },
  local: { reachable: true, total: 1, sessions: [{ id: 'ses_abc', title: 'Build', webUrl: 'https://host/session' }] },
  tailscale: { installed: true, running: true, selfName: 'laptop', selfIps: ['100.1.1.2'], peers: [{ hostName: 'desktop', dnsName: 'desktop.example.ts.net', online: true, detected: true, loginRequired: true, url: 'https://desktop.example.ts.net/' }] },
  publication: { published: true, url: 'https://laptop.example.ts.net/' }
}))
console.assert(parsed.local.sessions.length === 1, 'session parse')
console.assert(parsed.local.sessions[0].webUrl === 'https://host/session', 'web URL parse')
console.assert(parsed.publication.published === true, 'publication parse')
console.assert(parsed.tailscale.peers.length === 1 && parsed.tailscale.peers[0].loginRequired === true, 'peer parse')
console.assert(M.relativeTime(new Date().toISOString()) === 'Just now', 'relative time')
console.log('Model.js OK')
JS
fi

echo "== removed credential exchange =="
test ! -e opencode-remote-pair
test ! -e opencode-remote-connect
if grep -RniE 'Taildrop|pairingInbox|trustPairing|peer_credentials|openRemoteSession' -- README.md Model.js Service.qml Panel.qml opencode_remote_status.py opencode-remote-publish; then
  echo "FAIL: credential-exchange code remains" >&2
  exit 1
fi
if grep -RniE 'copyUrl|showQr|Show login QR|Copy URL' -- README.md Service.qml Panel.qml; then
  echo "FAIL: removed URL sharing controls remain" >&2
  exit 1
fi
echo OK

if command -v omarchy >/dev/null 2>&1; then
  echo "== omarchy plugin validate =="
  omarchy plugin validate .
fi

if grep -n "?\.\|??" BarWidget.qml Panel.qml Service.qml Model.js; then
  echo "FAIL: unsupported JS syntax found" >&2
  exit 1
fi
if grep -nE 'onClicked: [^{][^}]*; [^}]' Panel.qml; then
  echo "FAIL: multi-statement QML signal handler needs braces" >&2
  exit 1
fi
if grep -nE '\};[[:space:]]+[A-Za-z]+:' BarWidget.qml Panel.qml Service.qml; then
  echo "FAIL: QML child objects cannot be separated with semicolons" >&2
  exit 1
fi

echo "ALL GREEN"
