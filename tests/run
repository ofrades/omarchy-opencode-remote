#!/usr/bin/env bash
# Smoke tests for the omarchy-opencode-remote plugin. No shell state is
# changed: the helper only reads, and the Model.js tests run in node.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "== python syntax =="
python3 -m py_compile opencode_remote_status.py opencode-remote-connect opencode-remote-pair
echo OK

echo "== helper output =="
python3 opencode_remote_status.py | python3 -c "
import json, sys
d = json.load(sys.stdin)
assert d.get('ok') is True, 'ok flag missing'
assert 'opencode' in d and 'config' in d and 'local' in d and 'tailscale' in d
assert isinstance(d['local'].get('sessions'), list), 'local sessions missing'
assert isinstance(d['local'].get('total'), int), 'local total missing'
assert isinstance(d['local'].get('history'), list), 'local history missing'
assert len(d['local']['sessions']) <= d['local']['total'], 'open filter broken'
assert len(d['local']['sessions']) + len(d['local']['history']) == d['local']['total'], 'open+history != total'
assert isinstance(d['tailscale'].get('peers'), list), 'peers missing'
assert isinstance(d.get('pairing', {}).get('inbox'), list), 'pairing inbox missing'
for peer in d['tailscale']['peers']:
    assert isinstance(peer.get('sessions'), list), 'peer sessions missing'
print('local sessions:', len(d['local']['sessions']), '| peers:', len(d['tailscale']['peers']), '| local reachable:', d['local'].get('reachable'))
"
echo "== connect script help =="
python3 opencode-remote-connect --help | grep -q "Usage"
echo OK
echo "== pair script help =="
python3 opencode-remote-pair --help | grep -q "Usage"
echo OK

echo "== pairing trust flow (sandboxed HOME) =="
export SANDBOX_HOME="$(mktemp -d)"
export SANDBOX_XDG="$SANDBOX_HOME/.config"
mkdir -p "$SANDBOX_HOME/Downloads" "$SANDBOX_XDG"
cat > "$SANDBOX_HOME/Downloads/opencode-pair-test.json" <<'EOF'
{"app": "omarchy-opencode-remote-pair", "v": 1, "host": "desktop", "tailIP": "100.1.1.3", "port": 49374, "username": "opencode", "password": "s3cr3t-test-password", "created": "2026-09-17T00:00:00+0000"}
EOF
HOME="$SANDBOX_HOME" XDG_CONFIG_HOME="$SANDBOX_XDG" python3 opencode_remote_status.py | python3 -c "
import json, sys
d = json.load(sys.stdin)
inbox = d['pairing']['inbox']
assert len(inbox) == 1, inbox
assert inbox[0]['host'] == 'desktop' and inbox[0]['port'] == 49374, inbox
assert 'password' not in json.dumps(inbox) or 's3cr3t' not in json.dumps(inbox), 'secret leaked into status output'
print('inbox:', inbox[0]['host'], inbox[0]['fingerprint'])
"
HOME="$SANDBOX_HOME" XDG_CONFIG_HOME="$SANDBOX_XDG" python3 opencode-remote-pair trust "$SANDBOX_HOME/Downloads/opencode-pair-test.json" | grep -q "Trusted desktop"
test ! -e "$SANDBOX_HOME/Downloads/opencode-pair-test.json"
HOME="$SANDBOX_HOME" XDG_CONFIG_HOME="$SANDBOX_XDG" python3 -c "
import json
cfg = json.load(open('$SANDBOX_HOME/.config/omarchy-opencode-remote/config.json'))
assert cfg['peers']['desktop']['password'] == 's3cr3t-test-password', cfg
assert cfg['peers']['desktop']['port'] == 49374, cfg
print('config entry OK')
"
HOME="$SANDBOX_HOME" XDG_CONFIG_HOME="$SANDBOX_XDG" python3 opencode_remote_status.py | python3 -c "
import json, sys
d = json.load(sys.stdin)
assert d['pairing']['inbox'] == [], 'inbox not drained'
print('inbox drained OK')
"
rm -rf "$SANDBOX_HOME"
unset SANDBOX_HOME SANDBOX_XDG
echo OK

if command -v node >/dev/null 2>&1; then
  echo "== Model.js =="
  node -e "
const M = require('./Model.js');
const empty = M.parseStatus('');
console.assert(Array.isArray(empty.local.sessions) && empty.local.sessions.length === 0, 'empty parse');
const sample = JSON.stringify({ ok: true, opencode: { installed: true, version: '2.0.5' }, config: { path: '/home/u/.config/omarchy-opencode-remote/config.json', exists: true, hasPassword: true, port: 49374 }, local: { reachable: true, url: 'http://127.0.0.1:49374', error: '', sessions: [{ id: 'ses_abc', title: 'Fix bug', directory: '/home/u/proj', agent: 'build', model: 'anthropic/claude-sonnet-4-5', updatedAt: new Date().toISOString() }] }, tailscale: { installed: true, running: true, selfName: 'laptop', selfIps: ['100.1.1.2'], peers: [{ hostName: 'desktop', dnsName: '', os: 'linux', online: true, ips: ['100.1.1.3'], reachable: true, url: 'http://100.1.1.3:49374', error: '', sessions: [{ id: 'ses_def', title: '', directory: '/home/u/other', agent: '', model: 'openai/gpt-5', updatedAt: new Date(Date.now() - 3600e3).toISOString() }] }] }, lastError: '' });
const p = M.parseStatus(sample);
console.assert(p.local.sessions.length === 1 && p.local.sessions[0].title === 'Fix bug', 'local parse');
console.assert(p.local.total === 0, 'local total defaults to 0');
console.assert(Array.isArray(p.local.history) && p.local.history.length === 0, 'local history defaults empty');
console.assert(p.tailscale.peers[0].sessions[0].title === 'Untitled session', 'title fallback');
console.assert(M.totalSessions(p) === 2, 'total count');
console.assert(M.reachableHosts(p) === 2, 'reachable count');
console.assert(M.sessionSubtitle(p.local.sessions[0]).indexOf('/home/u/proj') === 0, 'subtitle');
console.assert(M.relativeTime(new Date().toISOString()) === 'Just now', 'relative time');
console.assert(M.peerLabel(p.tailscale.peers[0]) === 'desktop · 100.1.1.3', 'peer label');
console.assert(M.isConfigured(p) === true, 'configured');
const paired = M.parseStatus(JSON.stringify({ pairing: { inbox: [{ file: '/home/u/Downloads/opencode-pair-x.json', host: 'desktop', tailIP: '100.1.1.3', port: 49374, username: 'opencode', created: '2026-09-17', fingerprint: 'abc123' }, null] } }));
console.assert(paired.pairing.inbox.length === 1 && paired.pairing.inbox[0].host === 'desktop', 'pairing inbox');
const bad = M.parseStatus('{nope');
console.assert(bad.ok === false, 'bad json');
console.log('Model.js OK');
"
else
  echo "(node missing, skipping Model.js tests)"
fi

if command -v omarchy >/dev/null 2>&1; then
  echo "== omarchy plugin validate =="
  omarchy plugin validate .
  echo OK
else
  echo "(omarchy missing, skipping validate)"
fi

echo "== QML guards =="
# The Qt toolchain on some machines predates the typed-JS syntax stock
# Omarchy plugins use, so qmllint/qmlformat can fail even on first-party
# files. Only run them when they pass on a stock plugin (canary).
if command -v qmllint >/dev/null 2>&1 && [ -n "${OMARCHY_PATH:-}" ] \
  && qmllint -I "$OMARCHY_PATH/shell" "$OMARCHY_PATH/shell/plugins/panels/clock/BarWidget.qml" >/dev/null 2>&1; then
  echo "== qmllint =="
  qmllint -I "$OMARCHY_PATH/shell" BarWidget.qml Panel.qml Service.qml
  echo OK
else
  echo "(qmllint too old for stock plugins here, skipping)"
fi
# No optional-chaining / nullish-coalescing: not guaranteed in the QML engine.
if grep -n "?\.\|??" BarWidget.qml Panel.qml Service.qml Model.js opencode-remote-connect opencode-remote-pair; then
  echo "FAIL: unsupported JS syntax found" >&2
  exit 1
fi
echo OK

echo "ALL GREEN"
